<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Writes the generated sources to obj/<Configuration>/net10.0/generated so you can inspect them. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiniDI\MiniDI.csproj" />
    <!-- The generator runs inside the compiler: reference it as an analyzer, not as a library. -->
    <ProjectReference Include="..\MiniDI.Generator\MiniDI.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
